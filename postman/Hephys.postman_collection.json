  "item": [
    {
      "name": "00 · Sin sesión",
      "description": "Debe ejecutarse antes de cualquier login.",
      "item": [
        {
          "name": "Alumno sin sesión → login",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/estudiante/mis-solicitudes/",
            "description": "Sin sesión, Django redirige al login."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Redirige al login o lo muestra', () => {",
                  "  pm.expect([200, 302]).to.include(pm.response.code);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "  pm.test('Formulario de login visible', () => {",
                  "    pm.expect(pm.response.text()).to.include('name=\"matricula\"');",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
