{
  "info": {
    "_postman_id": "b6b0b6f2-6f8b-4d1a-9d0e-4d5f3b1a7c21",
    "name": "Hephys — Pruebas funcionales",
    "description": "Colección para probar los endpoints reales de Hephys contra el servidor local o Render.\n\nHephys es una aplicación renderizada en el servidor (no es una API REST): las respuestas son HTML y la sesión viaja en cookies. La colección obtiene el token CSRF, inicia sesión y conserva la cookie de sesión automáticamente.\n\nAntes de ejecutar, edita las variables de la colección (matrícula, usuarios y contraseñas). Ejecuta las carpetas en orden: cada inicio de sesión cambia el usuario de la sesión.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000",
      "type": "string",
      "description": "URL del servidor (local o Render)."
    },
    {
      "key": "matriculaAlumno",
      "value": "S24000001",
      "type": "string",
      "description": "Matrícula de un alumno registrado."
    },
    {
      "key": "passwordAlumno",
      "value": "CAMBIAR",
      "type": "string",
      "description": "Contraseña del alumno."
    },
    {
      "key": "usuarioSecretaria",
      "value": "secretaria",
      "type": "string",
      "description": "Usuario (nómina) de una secretaria de grupo."
    },
    {
      "key": "passwordSecretaria",
      "value": "CAMBIAR",
      "type": "string",
      "description": "Contraseña de la secretaria."
    },
    {
      "key": "usuarioAdministrador",
      "value": "admin",
      "type": "string",
      "description": "Usuario con rol administrador (Secretaría Académica)."
    },
    {
      "key": "passwordAdministrador",
      "value": "CAMBIAR",
      "type": "string",
      "description": "Contraseña del administrador."
