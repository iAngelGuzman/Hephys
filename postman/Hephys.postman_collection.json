    {
      "name": "02 · Sesión alumno",
      "description": "Login y pantallas del rol alumno.",
      "item": [
        {
          "name": "0. Cerrar sesión previa",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              },
              {
                "key": "X-CSRFToken",
                "value": "{{csrfToken}}"
              }
            ],
            "url": "{{baseUrl}}/logout/",
            "description": "Deja la sesión en anónimo para que la carpeta funcione aunque se ejecute después de otra. Si ya no hay sesión, Django solo redirige al login.",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "csrfmiddlewaretoken",
                  "value": "{{csrfToken}}",
                  "type": "text"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Obtiene un token CSRF válido aunque la sesión anterior siga abierta.",
                  "pm.sendRequest(pm.variables.replaceIn('{{baseUrl}}/login/'), function (err, res) {",
                  "  const csrf = pm.cookies.get('csrftoken');",
                  "  if (csrf) {",
                  "    pm.collectionVariables.set('csrfToken', csrf);",
                  "  }",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Sesión anterior cerrada o ya era anónima', () => {",
                  "  pm.expect([200, 302, 303]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "1. Obtener CSRF",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/login/",
            "description": "Abre el formulario y guarda la cookie csrftoken."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const csrf = pm.cookies.get('csrftoken');",
                  "if (csrf) {",
                  "  pm.collectionVariables.set('csrfToken', csrf);",
                  "}",
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Cookie csrftoken disponible', () => {",
                  "  pm.expect(csrf, 'cookie csrftoken').to.be.a('string');",
                  "  pm.expect(csrf.length).to.be.above(10);",
                  "});",
                  "pm.test('Formulario de login visible', () => {",
                  "  pm.expect(pm.response.text()).to.include('name=\"matricula\"');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Iniciar sesión",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              },
              {
                "key": "X-CSRFToken",
                "value": "{{csrfToken}}"
              }
            ],
            "url": "{{baseUrl}}/login/",
            "description": "Envía el formulario de login. Django exige el token CSRF en el cuerpo y en el encabezado X-CSRFToken. La cookie de sesión la guarda Postman automáticamente.",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "matricula",
                  "value": "{{matriculaAlumno}}",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "{{passwordAlumno}}",
                  "type": "text"
                },
                {
                  "key": "csrfmiddlewaretoken",
                  "value": "{{csrfToken}}",
                  "type": "text"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const csrf = pm.cookies.get('csrftoken');",
                  "if (csrf) {",
                  "  pm.collectionVariables.set('csrfToken', csrf);",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Credenciales aceptadas', () => {",
                  "  pm.expect([200, 302, 303]).to.include(pm.response.code);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "  pm.test('Llegó al panel del rol', () => {",
                  "    pm.expect(pm.response.text()).to.include('Trámites Escolares');",
                  "  });",
                  "} else {",
                  "  pm.test('Redirige al panel del rol', () => {",
                  "    const location = pm.response.headers.get('Location') || '';",
                  "    pm.expect(location).to.include('/solicitudes/lista-tramites/');",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        },
