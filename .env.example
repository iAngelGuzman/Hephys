# Copia este archivo como ".env" y ajusta los valores.
# ".env" nunca debe subirse a git (ya está en .gitignore).

# Genera una nueva con:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=cambia-esto-por-una-clave-generada

# En desarrollo: True. En producción: False (obligatorio).
DEBUG=True

# Dominios/IPs separados por coma.
ALLOWED_HOSTS=localhost,127.0.0.1

# Solo en producción: el dominio con https:// (ej. https://hephys.onrender.com)
CSRF_TRUSTED_ORIGINS=

# ---------------------------------------------------------------------------
# Base de datos
# ---------------------------------------------------------------------------
# True  -> usa SQLite local (db.sqlite3). Las variables DB_* se ignoran.
# False -> usa MySQL con las variables DB_* de abajo.
USE_SQLITE=True

DB_NAME=sistema
DB_USER=root
DB_PASSWORD=cambia-esto-por-tu-password
DB_HOST=localhost
DB_PORT=3306

# True para Aiven (exige conexión cifrada). False para MySQL local.
DB_SSL=False