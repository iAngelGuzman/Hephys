# Copia este archivo como ".env" y ajusta los valores.
# ".env" nunca debe subirse a git (ya está en .gitignore).

# Genera una nueva con:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=cambia-esto-por-una-clave-generada

# En desarrollo: True. En producción: False (obligatorio).
DEBUG=True

# Dominios/IPs separados por coma.
ALLOWED_HOSTS=localhost,127.0.0.1

# Solo en producción: el dominio con https:// (ej. https://hephys.onrender.com)
CSRF_TRUSTED_ORIGINS=

# ---------------------------------------------------------------------------
# Base de datos (MySQL)
# ---------------------------------------------------------------------------
# Crea la base con:  mysql -u root -p < database/crear_base.sql
DB_NAME=hephys_db
# En local se puede usar root; en producción usa un usuario solo con permisos
# sobre hephys_db (database/crear_base.sql crea hephys_user).
DB_USER=root
DB_PASSWORD=cambia-esto-por-tu-password
DB_HOST=localhost
DB_PORT=3306

# Segundos que Django reutiliza una conexión abierta (0 = cerrar siempre).
DB_CONN_MAX_AGE=60

# True para Aiven u otro proveedor que exija TLS. False para MySQL local.
DB_SSL=False
# Ruta al certificado CA, solo si el proveedor la pide.
DB_SSL_CA=
